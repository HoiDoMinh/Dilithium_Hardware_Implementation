module shake256_squeezeblocks #(
    parameter MAX_NBLOCKS = 5,
    parameter SHAKE256_RATE = 136
)(
    input clock,
    input reset,
    input start,
    input [1599:0] state_s_in,
    input [63:0] nblocks,
    output reg [(SHAKE256_RATE*8*MAX_NBLOCKS)-1:0] out,
    output reg [1599:0] state_s_out,
    output reg done
);
    localparam RATE_BITS = SHAKE256_RATE * 8;  // 1088 bits
    
    // FSM states
    localparam IDLE = 3'd0;
    localparam START_BLOCK = 3'd1;
    localparam WAIT_BLOCK = 3'd2;
    localparam NEXT_BLOCK = 3'd3;
    localparam FINISH = 3'd4;
    
    reg [2:0] state, next_state;
    reg [63:0] block_count;
    reg start_block;
    reg [1599:0] current_state;
    
    wire [RATE_BITS-1:0] block_out;
    wire [1599:0] next_state_wire;
    wire done_block;
    
    // Instantiate single-block squeezer
    keccak_squeezeblocks #(.outlen(RATE_BITS)) K (
        .clock(clock),
        .reset(reset),
        .start(start_block),
        .nblocks(1),
        .s_in(current_state),
        .r(SHAKE256_RATE),
        .out(block_out),
        .s_out(next_state_wire),
        .done(done_block)
    );
    
    // State register
    always @(posedge clock) begin
        if(reset) begin
            state <= IDLE;
        end else begin
            state <= next_state;
        end
    end
    
    // Datapath
    always @(posedge clock) begin
        if(reset) begin
            done <= 0;
            block_count <= 0;
            current_state <= 0;
            out <= 0;
            state_s_out <= 0;
        end else begin
            case(state)
                IDLE: begin
                    done <= 0;
                    if(start) begin
                        block_count <= 0;
                        current_state <= state_s_in;
                    end
                end
                
                START_BLOCK: begin
                    // Just transitioning, start_block will be set in control logic
                end
                
                WAIT_BLOCK: begin
                    if(done_block) begin
                        // Capture the output block
                        out[block_count * RATE_BITS +: RATE_BITS] <= block_out;
                        current_state <= next_state_wire;
                    end
                end
                
                NEXT_BLOCK: begin
                    block_count <= block_count + 1;
                end
                
                FINISH: begin
                    done <= 1;
                    state_s_out <= current_state;
                end
            endcase
        end
    end
    
    // Control logic (FSM transitions and start_block)
    always @(*) begin
        next_state = state;
        start_block = 0;
        
        case(state)
            IDLE: begin
                if(start) begin
                    next_state = START_BLOCK;
                end
            end
            
            START_BLOCK: begin
                start_block = 1;  // Trigger block squeeze
                next_state = WAIT_BLOCK;
            end
            
            WAIT_BLOCK: begin
                if(done_block) begin
                    if(block_count == nblocks - 1) begin
                        // All blocks done
                        next_state = FINISH;
                    end else begin
                        // More blocks to process
                        next_state = NEXT_BLOCK;
                    end
                end
            end
            
            NEXT_BLOCK: begin
                // Increment happened in datapath, now start next block
                next_state = START_BLOCK;
            end
            
            FINISH: begin
                next_state = IDLE;
            end
            
            default: begin
                next_state = IDLE;
            end
        endcase
    end

endmodule
