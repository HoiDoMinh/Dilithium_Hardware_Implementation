module montgomery_reduce_comb (
    input  signed [63:0] a,    // Input là k?t qu? nhân a*b (64-bit)
    output signed [31:0] r     // Output là k?t qu? ?ã reduce (32-bit)
);
    // Constants
    localparam signed [31:0] QINV = 32'sd58728449; // 58728449
    localparam signed [31:0] Q    = 32'sd8380417;  // 8380417

    wire signed [31:0] t;
    wire signed [63:0] t_times_q;
    wire signed [63:0] result_wide;

    // t = (int32_t)a * QINV
    assign t = a[31:0] * QINV;

    // r = (a - t*Q) >> 32
    assign t_times_q = t * Q; // M? r?ng sign t? ??ng
    assign result_wide = a - t_times_q;
    
    // Arithmetic shift right (>>>) ?? gi? d?u
    assign r = result_wide >>> 32;

endmodule