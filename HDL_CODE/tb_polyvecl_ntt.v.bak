`timescale 1ns/1ps
`include "byte_and_print.vh"

module tb_polyvecl_ntt;

    // PARAMETERS
    localparam L = 5;
    localparam K = 6;
    localparam N = 256;
    localparam DATA_WIDTH = 32;
    
    localparam SIZE_S1 = L * N * DATA_WIDTH; // 40960 bits
    localparam SIZE_S2 = K * N * DATA_WIDTH; // 49152 bits
    localparam SIZE_T0 = K * N * DATA_WIDTH; // 49152 bits

    localparam BYTES_S1 = SIZE_S1 / 8;
    localparam BYTES_S2 = SIZE_S2 / 8;
    localparam BYTES_T0 = SIZE_T0 / 8;

    // =========================================================
    // SIGNALS
    // =========================================================
    reg clock;
    reg reset;
    
    // Signals for S1 Test
    reg  start_s1;
    reg  [SIZE_S1-1:0] s1_in; // Input Register
    wire [SIZE_S1-1:0] s1_out;
    wire done_s1;

    // Signals for S2 Test
    reg  start_s2;
    reg  [SIZE_S2-1:0] s2_in; // Input Register
    wire [SIZE_S2-1:0] s2_out;
    wire done_s2;

// Signals for t0 Test
    reg  start_t0;
    reg  [SIZE_S2-1:0] t0_in; // Input Register
    wire [SIZE_S2-1:0] t0_out;
    wire done_t0;

    // Byte arrays for dumping
    wire [7:0] s1_bytes_out [0:BYTES_S1-1];
    wire [7:0] s2_bytes_out [0:BYTES_S2-1];
    wire [7:0] t0_bytes_out [0:BYTES_S2-1];

	
    
    integer fd, i;

    
    // Unit 1: Test S1 (PolyvecL)
    polyvecl_ntt #(.L(L)) dut_s1 (
        .clock(clock),
        .reset(reset),
        .start(start_s1),
        .v_in (s1_in),
        .v_out(s1_out),
        .done (done_s1)
    );

    // Unit 2: Test S2 (PolyvecK) - Uncomment if you have this module ready
   
    polyveck_ntt #(.K(K)) dut_s2 (
        .clock(clock),
        .reset(reset),
        .start(start_s2),
        .v_in (s2_in),
        .v_out(s2_out),
        .done (done_s2)
    );

    polyveck_ntt #(.K(K)) dut_t0 (
        .clock(clock),
        .reset(reset),
        .start(start_t0),
        .v_in (t0_in),
        .v_out(t0_out),
        .done (done_t0)
    );
    


    initial clock = 0;
    always #5 clock = ~clock;

`BYTE_ASSIGN_GEN(s1_out_arr, SIZE_S1/8, s1_out, s1_bytes_out)
`BYTE_ASSIGN_GEN(s2_out_arr, SIZE_S2/8, s2_out, s2_bytes_out)
`BYTE_ASSIGN_GEN(t0_out_arr, SIZE_S2/8, t0_out, t0_bytes_out)
    initial begin

        s1_in = 40960';
        s2_in = 49152';
	t0_in = 49152';
        
        
        // -----------------------------------------------------
        // 2. RESET SYSTEM
        // -----------------------------------------------------
        $display("\n[TB] Resetting...");
        reset = 1;
        start_s1 = 0;
        start_s2 = 0;
	start_t0 = 0;
        #100;
        reset = 0;
        #20;


        // 
        start_s1 = 1;
	start_s2 = 1; 
	start_t0 = 1; 
        #40 // Pulse start
	start_s1 = 0; 
	start_s2 = 0; 
	start_t0 = 0; 
        // Wait for Done
        wait(done_s1 && done_s2 && done_t0);
        #20; // Margin

        `DUMP_HEX_FILE("s1_ntt_verilog.hex", s1_bytes_out, BYTES_S1)
	`DUMP_HEX_FILE("s2_ntt_verilog.hex", s1_bytes_out, BYTES_S1)
	`DUMP_HEX_FILE("t0_ntt_verilog.hex", s1_bytes_out, BYTES_S1)

        $display("[TB] Output dumped to s1_ntt_verilog.hex");
        
   
        $system("notepad s1_ntt_verilog.hex");
	$system("notepad s2_ntt_verilog.hex");
	$system("notepad t0_ntt_verilog.hex");

        #100;

        $finish;
    end

    // Timeout
    initial begin
        #500000;
        $display("ERROR: Timeout!");
        $finish;
    end

endmodule