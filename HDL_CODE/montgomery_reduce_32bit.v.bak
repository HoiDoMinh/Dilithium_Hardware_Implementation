module montgomery_reduce (
    input  signed [63:0] a,
    output signed [31:0] t
);
    localparam signed [31:0] QINV = 32'sd58728449;  // -q^-1 mod 2^32
    localparam signed [31:0] Q    = 32'sd8380417;
    
    wire signed [31:0] temp1;
    wire signed [63:0] temp2;
    
    // t = (int32_t)a * QINV
    assign temp1 = a[31:0] * QINV;
    
    // temp2 = t * Q
    assign temp2 = temp1 * Q;
    
    // result = (a - temp2) >> 32
    assign t = (a - temp2) >>> 32;  // Arithmetic shift
endmodule