module polyvecl_pointwise_poly_montgomery (
    input  wire                   clock,
    input  wire                   reset,
    input  wire                   start,
    input  wire signed [8191:0]   a_in,   // 1 Poly A
    input  wire signed [40959:0]  v_in,   // Vector V (5 Poly)
    output reg  signed [40959:0]  r_out,  // Result
    output reg                    done
);

    localparam L = 5;
    localparam N = 256;

    // --- 1. DATA UNPACKING (Không t?n logic, ch? là n?i dây) ---
    // M?ng wire ?? truy xu?t h? s? d? dàng mà không gây l?i index ??ng
    wire signed [31:0] a_coeffs [0:N-1];
    wire signed [31:0] v_coeffs [0:L-1][0:N-1];

    genvar i, k;
    generate
        // Unpack A
        for (i = 0; i < N; i = i + 1) begin : UNPACK_A
            assign a_coeffs[i] = a_in[32*i + 31 : 32*i];
        end

        // Unpack V (L=5 polys)
        for (k = 0; k < L; k = k + 1) begin : UNPACK_V
            for (i = 0; i < N; i = i + 1) begin : UNPACK_V_COEFFS
                assign v_coeffs[k][i] = v_in[(k*N + i)*32 + 31 : (k*N + i)*32];
            end
        end
    endgenerate

    // --- 2. CALCULATION CORE (5 Parallel Units) ---
    reg  [8:0] counter;
    reg        running;
     integer store_idx;
    // Input registers cho b? nhân (Pipeline Stage 1)
    reg signed [31:0] reg_a;
    reg signed [31:0] reg_v [0:L-1];
    
    // Wires k?t qu? t? b? Reduce (Combinational)
    wire signed [31:0] res_node [0:L-1];

    generate
        for (k = 0; k < L; k = k + 1) begin : CALC_UNITS
            wire signed [63:0] product;
            
            // Nhân: a * v (K?t qu? 64 bit)
            assign product = reg_a * reg_v[k];
            
            // Reduce: G?i module t? h?p
            montgomery_reduce u_red (
                .a(product),
                .t(res_node[k])
            );
        end
    endgenerate

    // --- 3. CONTROL LOGIC & PIPELINE ---
    always @(posedge clock) begin
        if (reset) begin
            counter <= 0;
            running <= 0;
            done    <= 0;
            r_out   <= 0;
            reg_a   <= 0;
            // Reset reg_v th? công ho?c dùng loop
            reg_v[0] <= 0; reg_v[1] <= 0; reg_v[2] <= 0; reg_v[3] <= 0; reg_v[4] <= 0;
        end else begin
            // Logic Start
            if (start) begin
                running <= 1;
                counter <= 0;
                done    <= 0;
            end

            if (running) begin
                // --- STAGE 1: FETCH DATA ---
                // L?y d? li?u t? m?ng wire ??a vào thanh ghi pipeline
                if (counter < N) begin
                    reg_a    <= a_coeffs[counter];
                    reg_v[0] <= v_coeffs[0][counter];
                    reg_v[1] <= v_coeffs[1][counter];
                    reg_v[2] <= v_coeffs[2][counter];
                    reg_v[3] <= v_coeffs[3][counter];
                    reg_v[4] <= v_coeffs[4][counter];
                end

                // --- STAGE 2: STORE RESULT ---
                // Sau 1 clock, phép nhân+reduce ?ã xong (nh? logic t? h?p), ta l?u vào r_out
                // Vì có delay 1 clock n?p d? li?u, nên khi counter=1 thì k?t qu? c?a counter=0 m?i có.
                if (counter > 0) begin
                    // Tính index l?u tr?: (counter - 1)
                   
                    store_idx = counter - 1;
                    
                    r_out[(0*N + store_idx)*32 +: 32] <= res_node[0];
                    r_out[(1*N + store_idx)*32 +: 32] <= res_node[1];
                    r_out[(2*N + store_idx)*32 +: 32] <= res_node[2];
                    r_out[(3*N + store_idx)*32 +: 32] <= res_node[3];
                    r_out[(4*N + store_idx)*32 +: 32] <= res_node[4];
                end

                // --- CONTROL ---
                // Ch?y ??n 256 (?? l?u n?t ph?n t? 255)
                if (counter == N) begin
                    running <= 0;
                    done    <= 1;
                end else begin
                    counter <= counter + 1;
                end
            end else begin
                done <= 0; // Pulse done 1 cycle
            end
        end
    end

endmodule
